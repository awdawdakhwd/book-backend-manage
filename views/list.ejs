<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>图书借阅系统后台管理</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>图书借阅系统后台管理</h1>

    <% if (message) { %>
      <div class="alert"><%= message %></div>
    <% } %>

    <div class="toolbar">
      <form action="/" method="get" class="search-form">
        <input type="text" name="search" placeholder="请输入图书名称" value="<%= search %>">
        <button type="submit">查询</button>
        <a href="/" class="btn-clear">清除</a>
      </form>
      <a href="/add" class="btn-add">新增</a>
    </div>

    <table>
      <thead>
        <tr>
          <th>图书编号</th>
          <th>图书名称</th>
          <th>图书类型</th>
          <th>作者</th>
          <th>出版社</th>
          <th>是否借阅</th>
          <th>入库时间</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% if (books.length === 0) { %>
          <tr><td colspan="8" style="text-align:center;">暂无数据</td></tr>
        <% } %>
        <% books.forEach(function(book, index) { %>
          <tr class="<%= index % 2 === 0 ? 'even' : 'odd' %>">
            <td><%= book.bookCode %></td>
            <td><%= book.bookName %></td>
            <td><%= book.typeName %></td>
            <td><%= book.bookAuthor %></td>
            <td><%= book.publishPress %></td>
            <td><%= book.borrowed == 1 ? '已借阅' : '未借阅' %></td>
            <td><%= book.creationTime ? book.creationTime.toISOString().slice(0, 10) : '' %></td>
            <td class="actions">
              <a href="/detail/<%= book.bookId %>?search=<%= encodeURIComponent(search) %>&page=<%= page %>">查看</a>
              <a href="/edit/<%= book.bookId %>">修改</a>
              <a href="/delete/<%= book.bookId %>" class="btn-delete" onclick="return confirm('确定删除该图书信息？')">删除</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="pagination">
      <span>共 <%= total %> 条记录</span>
      <% if (page > 1) { %>
        <a href="/?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>">上一页</a>
      <% } %>
      <span>第 <%= page %> / <%= totalPages %> 页</span>
      <% if (page < totalPages) { %>
        <a href="/?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>">下一页</a>
      <% } %>
    </div>
  </div>
</body>
</html>