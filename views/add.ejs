<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>新增图书</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>新增图书</h1>
    <form action="/add" method="post" onsubmit="return validate()">
      <div class="form-group">
        <label>图书编号 <span class="required">*</span></label>
        <input type="text" name="bookCode" id="bookCode" required>
      </div>
      <div class="form-group">
        <label>图书名称 <span class="required">*</span></label>
        <input type="text" name="bookName" id="bookName" required>
      </div>
      <div class="form-group">
        <label>图书类型 <span class="required">*</span></label>
        <select name="bookType" id="bookType" required>
          <option value="">请选择</option>
          <% types.forEach(function(t) { %>
            <option value="<%= t.id %>"><%= t.typeName %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>作者 <span class="required">*</span></label>
        <input type="text" name="bookAuthor" id="bookAuthor" required>
      </div>
      <div class="form-group">
        <label>出版社 <span class="required">*</span></label>
        <input type="text" name="publishPress" id="publishPress" required>
      </div>
      <div class="form-group">
        <label>出版日期 <span class="required">*</span></label>
        <input type="date" name="publishDate" id="publishDate" required>
      </div>
      <div class="form-group">
        <label>是否借阅 <span class="required">*</span></label>
        <select name="borrowed" id="borrowed" required>
          <option value="0">未借阅</option>
          <option value="1">已借阅</option>
        </select>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">保存</button>
        <a href="/" class="btn">返回</a>
      </div>
    </form>
  </div>
  <script>
    function validate() {
      var fields = ['bookCode', 'bookName', 'bookType', 'bookAuthor', 'publishPress', 'publishDate'];
      for (var i = 0; i < fields.length; i++) {
        var el = document.getElementById(fields[i]);
        if (!el.value.trim()) {
          alert('请填写所有必填项');
          el.focus();
          return false;
        }
      }
      return true;
    }
  </script>
</body>
</html>